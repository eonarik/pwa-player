# Яндекс OAuth (право cloud_api:disk.app_folder)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://твой-домен/api/auth/yandex/callback

# Токен яндекс диска
YANDEX_SELF_TOKEN=
YANDEX_SELF_PATH=/Music

# Секрет для подписи cookie сессии
SESSION_SECRET=

# SMTP для обратной связи
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FEEDBACK_TO=

# Телеметрия
TELEMETRY_ENABLED=true
TELEMETRY_DIR=./.telemetry
TELEMETRY_MAX_AGE_DAYS=30
TELEMETRY_MAX_FILE_MB=50

# Origin фронтенда для CORS (dev: http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

# Порт
PORT=3000