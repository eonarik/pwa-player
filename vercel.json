{
  "services": {
    "frontend": { "root": "." },
    "backend": {
      "root": "server/",
      "entrypoint": "src/index.mjs",
      "framework": "express"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
